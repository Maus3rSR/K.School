{
  "name": "@k.school/react",
  "version": "0.0.1",
  "private": "true",
  "type": "module",
  "scripts": {
    "build": "slidev build",
    "build:setup": "slidev build slides-setup.md --out dist/setup",
    "build:component": "slidev build slides-component.md --out dist/component",
    "build:props": "slidev build slides-props.md --out dist/props",
    "build:state": "slidev build slides-state.md --out dist/state",
    "build:hooks": "slidev build slides-hooks.md --out dist/hooks",
    "build:api": "slidev build slides-api.md --out dist/api",
    "build:router": "slidev build slides-router.md --out dist/router",
    "build:router-avance": "slidev build slides-router-avance.md --out dist/router-avance",
    "build:hooks-personnalises": "slidev build slides-hooks-personnalises.md --out dist/hooks-personnalises",
    "dev": "slidev slides-setup.md --open --port 3030 & slidev slides-component.md --open --port 3031 & slidev slides-props.md --open --port 3032 & slidev slides-state.md --open --port 3033",
    "dev:setup": "slidev slides-setup.md --open",
    "dev:component": "slidev slides-component.md --open",
    "dev:props": "slidev slides-props.md --open",
    "dev:state": "slidev slides-state.md --open",
    "dev:render.list": "slidev slides-rendu-listes.md --open",
    "dev:hooks": "slidev slides-hooks.md --open",
    "dev:api": "slidev slides-api.md --open",
    "dev:router": "slidev slides-router.md --open",
    "dev:router-avance": "slidev slides-router-avance.md --open",
    "dev:hooks-personnalises": "slidev slides-hooks-personnalises.md --open"
  },
  "dependencies": {
    "@k.school/slidev-addon-ui": "workspace:*",
    "@slidev/cli": "catalog:",
    "@slidev/theme-default": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/vscode-icons": "1.2.67"
  }
}
