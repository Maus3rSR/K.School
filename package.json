{
  "name": "k.school",
  "private": "true",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "export": "turbo run export",
    "docker:dev": "turbo run dev --filter @k.school/docker",
    "oop:dev": "turbo run dev --filter @k.school/oop",
    "react:dev": "turbo run dev --filter @k.school/react",
    "react:setup:dev": "pnpm --filter @k.school/react dev:setup",
    "react:component:dev": "pnpm --filter @k.school/react dev:component",
    "react:props:dev": "pnpm --filter @k.school/react dev:props",
    "react:state:dev": "pnpm --filter @k.school/react dev:state",
    "react:render.list:dev": "pnpm --filter @k.school/react dev:render.list",
    "react:hooks:dev": "pnpm --filter @k.school/react dev:hooks",
    "react:api:dev": "pnpm --filter @k.school/react dev:api",
    "react:router:dev": "pnpm --filter @k.school/react dev:router",
    "react:ex": "pnpm --filter @k.school/exercices-react dev",
    "tdd:dev": "turbo run dev --filter @k.school/tdd",
    "ubiquitous-language:dev": "turbo run dev --filter @k.school/ubiquitous-language",
    "vscode:dev": "turbo run dev --filter @k.school/vscode",
    "vscode:ex:navigation": "pnpm --filter @k.school/exercices-vscode run:navigation",
    "vscode:ex:dirty-code": "pnpm --filter @k.school/exercices-vscode run:dirty-code",
    "hexa:ex:coffee": "pnpm --filter @k.school/exercices-hexagonal-architecture dev:coffee-shop",
    "hexa:test:coffee": "pnpm --filter @k.school/exercices-hexagonal-architecture test:coffee-shop",
    "tdd:ex:pig-latin": "deno task --cwd exercices/tdd 01-pig-latin",
    "tdd:ex:string-calculator": "deno task --cwd exercices/tdd 02-string-calculator",
    "tdd:ex:roman-numerals": "deno task --cwd exercices/tdd 03-roman-numerals",
    "tdd:ex:pendu": "deno task --cwd exercices/tdd 04-pendu"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "packageManager": "pnpm@11.4.0"
}
